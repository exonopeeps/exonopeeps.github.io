# Copy to .dev.vars (gitignored) for `wrangler dev`. Values here override wrangler.toml [vars].
#
# The browser never sees any of this. The page on :5500 talks to the Worker on :8787, and
# only the Worker holds the partner key.

# The DEVELOPMENT partner key: Maintenance -> Partner Keys -> Create, partner name
# "ExonoPeePs.WWW Worker", custom domain "exono", environment Development (resolves
# exono:sql:staging), scopes offerings:read, offerings:write, entity-mappings:read,
# entity-mappings:write. Scopes can't be added to an existing key, so mint a new one.
# MOID 2322 may not exist in staging: point CLAIM_MOID below at staging test cards.
EXONOME_API_KEY=
EXONOME_SPID=
EXONOME_MOID=

# Any long random string. Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Real email when testing locally goes through SendGrid. The key is NOT kept here: the local runner
# reads it from D:\private\sendgrid-api-key.txt, the single source every app and agent uses.
# EMAIL_FROM must be a sender SendGrid has verified. Without the key file, set DEV_ECHO_CODE=1 to get
# the code on the page instead.
# EMAIL_FROM=
# (Cloudflare Email Service instead: CF_ACCOUNT_ID + D:\private\cf-email-token.txt, run with --cf-email;
#  needs the Workers paid plan.)

# Local-only switches. Never set these as production secrets.
DEV=1
DEV_ECHO_CODE=1
DEV_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Point these at your test data if it isn't The Exchange 2026.
# CLAIM_MOID=
# CLAIM_OFID_MIN=
# CLAIM_OFID_MAX=
